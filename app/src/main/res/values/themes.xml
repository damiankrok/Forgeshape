    <!--
      The two LIGHT appearances (UI-PREF-R1 D2/D3). Every role is answered from
      its own palette in colors.xml exactly as the dark three are: the same
      component tree, the same drawables, no view knows which is in force.
      The one thing the dark base cannot say for them is the system-bar icon
      appearance, so it is stated here.
    -->
    <style name="Theme.ForgeShape.LightBase" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- WARM LIGHT — a cream-biased paper. -->
    <style name="Theme.ForgeShape.WarmLight" parent="Theme.ForgeShape.LightBase">
