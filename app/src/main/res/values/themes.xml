<!--
  The three appearances, and the one place a semantic role is given a value.

  ForgeShape runs edge-to-edge on purpose. The window draws behind transparent
  system bars, the Vulkan SurfaceView keeps the whole window (it is never inset,
  padded or resized by any layout decision), and the interactive chrome is padded
  off the bars and cutouts by EditorWorkspaceView's inset listener. None of that
  differs between appearances.

  What differs is only the answers below. Every role in `attrs.xml` is given a
  value once per palette, and no view, drawable or colour state list in the
  project knows which appearance is in force.

  The three ORIGINAL appearances are DARK and share the Material (dark) parent.
  That is not decoration: it is what makes the one platform-drawn surface in
  the product — the destructive re-Freeze confirmation — belong to the same
  workspace. The two LIGHT appearances of UI-PREF-R1 (UI-OWNER-42) share the
  Material LIGHT parent for the same reason, and state that the system bars'
  icons must be dark over them. There is deliberately no `-night` qualifier and
  no `DayNight` parent: the appearance is an explicit user choice in Settings,
  not something the system picks.
-->
<resources>

    <!-- Everything the three appearances share: the window, the bars, and the
         fact that none of them has an action bar. Holds no colour of its own. -->
    <style name="Theme.ForgeShape.Base" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      WARM GRAPHITE — the product default.

      The window background matches the Vulkan clear colour rather than being
      plain black, so the moment before the surface has content does not flash a
      different shade than the viewport that replaces it.
    -->
    <style name="Theme.ForgeShape.WarmGraphite" parent="Theme.ForgeShape.Base">
        <item name="android:windowBackground">@color/p1_viewport_background</item>

        <item name="fsSurfaceFloating">@color/p1_surface_floating_translucent</item>
        <item name="fsSurfaceContext">@color/p1_surface_floating</item>
        <item name="fsSurfacePrecision">@color/p1_surface_precision</item>

        <item name="fsChromeSurface">@color/p1_chrome_surface</item>
        <item name="fsChromeOverlay">@color/p1_surface_floating_translucent</item>
        <item name="fsChromeHairline">@color/p1_chrome_hairline</item>

        <item name="fsControlSurface">@color/p1_control_surface</item>
        <item name="fsControlSurfacePressed">@color/p1_control_surface_pressed</item>
        <item name="fsControlBorder">@color/p1_control_border</item>
        <item name="fsFieldSurface">@color/p1_field_surface</item>

        <item name="fsAccent">@color/p1_accent</item>
        <item name="fsAccentFill">@color/p1_selected_rest</item>
        <item name="fsAccentFillPressed">@color/p1_selected_rest_pressed</item>
        <item name="fsAccentBorder">@color/p1_accent_border</item>
        <item name="fsPrimaryFill">@color/p1_accent</item>
        <item name="fsPrimaryFillPressed">@color/p1_primary_fill_pressed</item>
        <item name="fsTextOnPrimary">@color/p1_text_on_primary</item>

        <item name="fsTextPrimary">@color/p1_text_primary</item>
        <item name="fsTextSecondary">@color/p1_text_secondary</item>
        <item name="fsTextDisabled">@color/p1_text_disabled</item>

        <item name="fsTextSuccess">@color/p1_text_success</item>
        <item name="fsTextError">@color/p1_text_error</item>
        <item name="fsTextMeasure">@color/p1_text_measure</item>

        <item name="fsSliderTrack">@color/p1_slider_track</item>
        <item name="fsSliderFill">@color/p1_accent</item>
        <item name="fsSliderThumb">@color/p1_text_primary</item>

        <item name="fsChooserScrim">@color/p1_chooser_scrim</item>
        <item name="fsStartPageSurface">@color/p1_start_page_surface</item>
        <item name="fsStartPageMotif">@color/p1_start_page_motif</item>
        <item name="fsChooserCardSurface">@color/p1_field_surface</item>
    </style>

    <!-- NEUTRAL CHARCOAL / STEEL. -->
