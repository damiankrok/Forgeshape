    <!--
      The manifest's theme. Warm Graphite is the product default; the Activity
      applies the user's stored choice with setTheme() before it inflates
      anything, so this is what a process whose preferences were never written
      gets.
    -->
    <style name="Theme.ForgeShape" parent="Theme.ForgeShape.WarmGraphite" />
</resources>
