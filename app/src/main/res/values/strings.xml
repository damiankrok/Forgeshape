    <!--
      Written out in full rather than as "Persp" / "Ortho": both labels fit the
      control, and the abbreviations are drafting jargon that a reader has to
      already know.
    -->
    <!--
      Appearance. "Appearance" rather than "Theme": it sits beside Shading,
      Surface and Projection, which are all about how the model is presented,
      and it is the same kind of decision.
    -->
    <string name="appearance">Appearance</string>
    <string name="appearance_warm_graphite">Warm Graphite</string>
