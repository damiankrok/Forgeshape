    <!--
      Start chooser. Two ways to begin and nothing else: no template gallery,
      no recent list, no marketing. The subtitle says the choice is not a
      commitment, because it genuinely is not — both representations stay
      reachable from the Global Toolbar for the life of the body.
    -->
    <string name="new_project">New Project</string>
    <string name="start_prompt">Choose how this model begins. You can move between Construction and Sculpt at any time.</string>
    <string name="start_construction_title">Construction / CAD</string>
    <string name="start_construction_description">Begin from an exact primitive and type its dimensions. Shape and placement stay exact, editable values.</string>
    <string name="start_sculpt_title">Sculpt</string>
