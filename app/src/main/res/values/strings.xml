<?xml version="1.0" encoding="utf-8"?>
<!--
  Every user-visible string in the Editor Workspace.

  Kept here rather than inline so the wording of a load-bearing message (the
  stale-source warning, the destructive re-Freeze confirmation, a rejection
  reason) can be reviewed in one place instead of hunted through view code.
-->
<resources>
    <string name="app_name">ForgeShape</string>

    <!--
      Start chooser. Two ways to begin and nothing else: no template gallery,
      no recent list, no marketing. The subtitle says the choice is not a
      commitment, because it genuinely is not — both representations stay
      reachable from the Global Toolbar for the life of the body.
    -->
    <string name="new_project">New Project</string>
    <string name="start_prompt">Choose how this model begins. You can move between Construction and Sculpt at any time.</string>
    <string name="start_construction_title">Construction / CAD</string>
    <string name="start_construction_description">Begin from an exact primitive and type its dimensions. Shape and placement stay exact, editable values.</string>
    <string name="start_sculpt_title">Sculpt</string>
    <string name="start_sculpt_description">Begin on a sphere already frozen for sculpting. Its exact source is kept, so Back to Construction returns to it.</string>
    <string name="status_started_construction">Construction — choose a shape, type its exact values, then Apply.</string>
    <string name="status_started_sculpt">Ready to sculpt a frozen sphere. The Construction sphere is kept.</string>
    <string name="status_sculpt_start_failed">Could not prepare a sculptable mesh. Still in Construction; nothing was changed.</string>

    <!-- Global Toolbar -->
    <string name="context_construction">Construction</string>
    <string name="context_sculpt">Sculpt</string>
    <string name="freeze_to_sculpt">Freeze to Sculpt</string>
