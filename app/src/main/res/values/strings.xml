    <string name="back_to_construction">Back to Construction</string>
    <string name="export">Export</string>
    <string name="export_reserved_note">Export is not implemented yet.</string>
    <string name="hide_ui">Hide UI</string>
    <string name="show_ui">Show UI</string>

