<?xml version="1.0" encoding="utf-8"?>
<!--
  The Editor Workspace's semantic roles, as theme attributes.

  This is the whole theme mechanism. A role is declared once here, given a value
  once per theme in `themes.xml`, and referenced as `?attr/fs*` from every
  drawable, colour state list and view. Nothing in the package asks for a
  *colour*; it asks for a *role*, and the theme in force answers.

  That is what keeps two themes from costing two component trees. There is one
  `bg_control.xml`, one `control_content_tint.xml` and one `chip()` — a Light
  build reuses all of them and only the answers change. No view class contains
  `if (light)`, and adding a third theme later would touch this file and
  `themes.xml` and nothing else.

  Platform mechanism only: theme attributes in drawables are resolved by
  `Resources.getDrawable(id, theme)` and in colour state lists from API 23.
  minSdk is 26, so both are always available and no support library is involved.
-->
<resources>
    <!-- Chrome surfaces. Opaque where text sits on them; translucent only over
         the viewport, where the model behind stays informative. -->
    <attr name="fsChromeSurface" format="color" />
    <attr name="fsChromeOverlay" format="color" />
    <attr name="fsChromeHairline" format="color" />

    <!-- Controls at rest and under a finger. -->
    <attr name="fsControlSurface" format="color" />
    <attr name="fsControlSurfacePressed" format="color" />
    <attr name="fsControlBorder" format="color" />

    <!--
      The accent, split by JOB rather than by shade.

      `fsAccentFill` is what an ACTIVE control is filled with; `fsPrimaryFill` is
      what a PRIMARY COMMIT is filled with. In the dark theme those happen to be
      the same colour, which is exactly why they were one value before and why
      that could not survive a light theme: on a light background an active chip
      wants a pale tint it can carry dark text on, and Apply wants a solid accent
      carrying white. One attribute could not be both.
    -->
    <attr name="fsAccent" format="color" />
    <attr name="fsAccentFill" format="color" />
    <attr name="fsAccentFillPressed" format="color" />
    <attr name="fsAccentBorder" format="color" />
    <attr name="fsPrimaryFill" format="color" />
    <attr name="fsPrimaryFillPressed" format="color" />
    <attr name="fsTextOnPrimary" format="color" />

    <!-- Text. Disabled stays legible enough to read a reserved feature's name,
         because a reserved control the user cannot read is just noise. -->
    <attr name="fsTextPrimary" format="color" />
    <attr name="fsTextSecondary" format="color" />
    <attr name="fsTextDisabled" format="color" />

    <!-- Verdicts and measurements. These must stay distinguishable from each
         other AND from body text in both themes. -->
    <attr name="fsTextSuccess" format="color" />
    <attr name="fsTextError" format="color" />
    <attr name="fsTextMeasure" format="color" />

    <!-- The two brush sliders, which are drawn rather than composed. -->
    <attr name="fsSliderTrack" format="color" />
    <attr name="fsSliderFill" format="color" />
    <attr name="fsSliderThumb" format="color" />

    <!-- The start chooser. -->
    <attr name="fsChooserScrim" format="color" />
    <attr name="fsChooserCardSurface" format="color" />
</resources>
