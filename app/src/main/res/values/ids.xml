<?xml version="1.0" encoding="utf-8"?>
<!--
  Stable semantic view identifiers for the Editor Workspace.

  These exist so verification names a control by what it DOES rather than by
  where it happens to sit. Every runtime check before this stage was driven by
  screen coordinates, which is why a layout change silently invalidated the
  pixel tables twice. A name here is part of the test contract: renaming one
  breaks tests on purpose, moving the control breaks nothing.
-->
<resources>
    <!-- Shell -->
    <item name="editor_workspace" type="id" />
    <item name="viewport_surface" type="id" />

    <!--
      Home (APP-H1): what ForgeShape shows when NO project is open. Exactly two
      primary actions, because a project comes to exist exactly two ways. Home
      is not a project: nothing is drawn behind it, and whether it is on screen
      is derived from native truth (projectOpen) rather than remembered.
    -->
    <!-- The start pages: Home and New Project (`SKETCH-UX-R1` A). A page,
         not a modal; `home_panel` names the content column inside it. -->
    <item name="home_surface" type="id" />
    <item name="start_page_wordmark" type="id" />
    <item name="start_page_mark" type="id" />
    <item name="start_page_product_name" type="id" />
    <item name="start_page_headline" type="id" />
    <item name="home_panel" type="id" />
    <item name="home_new_project" type="id" />
    <!-- Settings (UI-PREF-R1): the page, its content column, and the row on
         Home and on the Project surface that open it. -->
    <item name="home_settings" type="id" />
    <item name="project_settings" type="id" />
    <item name="settings_page" type="id" />
    <item name="settings_panel" type="id" />
    <item name="settings_back" type="id" />
    <!-- Its rows, named for the act each performs. The three original
         appearance ids are unchanged: an id names the act, not the surface it
         moved to. -->
    <item name="appearance_warm_light" type="id" />
    <item name="appearance_cool_light" type="id" />
    <item name="handedness_right" type="id" />
    <item name="handedness_left" type="id" />
    <item name="gizmo_size_small" type="id" />
    <item name="gizmo_size_default" type="id" />
    <item name="gizmo_size_large" type="id" />
    <item name="gizmo_size_largest" type="id" />
    <item name="gizmo_weight_thin" type="id" />
    <item name="gizmo_weight_regular" type="id" />
    <item name="gizmo_weight_bold" type="id" />
    <item name="home_open_file" type="id" />
    <!--
      The New Project chooser: which representation a new project begins in.
      CAD enters the transient CAD bootstrap (spatial plane chooser, one
      sketch, and the first Extrude creates the project); Sculpt seeds a
      sphere through the product's own Freeze. Reached from Home and from an
      open project's Project surface; Cancel returns to wherever it was opened.
    -->
    <item name="new_project_chooser" type="id" />
    <item name="new_project_chooser_panel" type="id" />
    <item name="new_project_cad" type="id" />
    <item name="new_project_sculpt" type="id" />
    <item name="new_project_cancel" type="id" />

    <!-- The sketch orientation navigator (`SKETCH-UX-R1` C). Ids name the ACT:
         choose a support plane, flip the view normal, roll the view. -->
    <item name="sketch_orientation_navigator" type="id" />
    <item name="sketch_navigator_view_label" type="id" />
    <item name="sketch_navigator_plane_xy" type="id" />
    <item name="sketch_navigator_plane_xz" type="id" />
    <item name="sketch_navigator_plane_yz" type="id" />
    <item name="sketch_navigator_flip" type="id" />
    <item name="sketch_navigator_rotate_ccw" type="id" />
    <item name="sketch_navigator_rotate_cw" type="id" />

    <!-- The selected Line's dimension label and its numeric editor. -->
    <item name="sketch_dimension_label" type="id" />
    <item name="sketch_dimension_value" type="id" />
    <item name="sketch_dimension_editor" type="id" />
    <item name="field_sketch_line_length" type="id" />
    <item name="apply_sketch_line_length" type="id" />
    <!--
      The unsaved-changes question, asked when New Project or Open File would
      leave a project whose changes nobody saved. Save persists then continues,
      Discard continues without writing, Cancel stays. Asked only when the
      project is genuinely dirty by fingerprint.
    -->
    <item name="unsaved_prompt" type="id" />
    <item name="unsaved_prompt_panel" type="id" />
    <item name="unsaved_save" type="id" />
    <item name="unsaved_discard" type="id" />
    <item name="unsaved_cancel" type="id" />
    <!-- The way out of the CAD bootstrap before its first commit: no project
         exists yet, so leaving costs nothing. Full wording, never abbreviated. -->
    <item name="back_to_home" type="id" />

    <!-- Global Toolbar -->
    <item name="global_toolbar" type="id" />
    <item name="toolbar_editing_group" type="id" />
    <item name="toolbar_utility_group" type="id" />
    <item name="editing_context_label" type="id" />
    <item name="freeze_to_sculpt" type="id" />
    <item name="resume_sculpt" type="id" />
    <item name="back_to_construction" type="id" />
    <item name="export_action" type="id" />
    <!--
      Project actions. There is ONE app-private project slot, so there are
      exactly two entries: Save Project and Open Saved Project. The button lives
      in the Global Toolbar's utility group because a project is
      mode-independent, and the surface it opens grows out of that button like
      every other context surface.
    -->
    <item name="project_actions_button" type="id" />
    <item name="project_actions_popover" type="id" />
    <item name="project_save" type="id" />
    <item name="project_open" type="id" />
    <!--
      Project transfer through the system's own document UI, and the local
      diagnostic report. All three are on the same surface because they are the
      same kind of decision — what happens to this work outside the viewport —
      and none of them is a standard-format import or export.
    -->
    <item name="project_save_copy" type="id" />
    <item name="project_open_file" type="id" />
    <item name="project_share_diagnostics" type="id" />
    <!--
      IMPORT-01A: read a `.glb` and turn what it describes into durable
      objects. The id names the ACT, and the act changed when the preview
      became an import, so the id changed with it — a control called
      `import_glb_preview` that creates saved bodies would be a name nobody
      could trust. The session-only diagnostic preview it replaced has no
      control of its own any more: it is reached from the verification suites
      through JNI and draws nothing the user can open.
    -->
    <item name="import_glb" type="id" />

    <!--
      The recovery question, asked once on a cold launch when a validated
      checkpoint exists that the user never explicitly saved. It is not a Home
      screen: two answers, asked once, straight into the ordinary workspace.
    -->
    <item name="recovery_prompt" type="id" />
    <item name="recovery_prompt_panel" type="id" />
    <item name="recovery_recover" type="id" />
    <item name="recovery_discard" type="id" />
    <item name="display_settings_button" type="id" />
    <item name="hide_ui_toggle" type="id" />
    <item name="restore_ui_chip" type="id" />
    <item name="status_message" type="id" />

    <!--
      Display settings. Presentation only: none of these controls changes a
      dimension, a Construction parameter, a sculpt vertex or what is pickable.
      `display_mode_debug` exists only in a debuggable build.
    -->
    <item name="display_settings_popover" type="id" />
    <item name="display_mode_studio" type="id" />
    <item name="display_mode_matcap" type="id" />
    <item name="display_mode_debug" type="id" />
    <item name="surface_shading_smooth" type="id" />
    <item name="surface_shading_faceted" type="id" />

    <!--
      Appearance. Presentation only, and the one place the theme is chosen:
      there is deliberately no settings screen and no second popover class.
    -->
    <item name="appearance_warm_graphite" type="id" />
    <item name="appearance_neutral_charcoal" type="id" />
    <item name="appearance_light_charcoal" type="id" />

    <!--
      Camera projection. It shares the display surface because it is the other
      thing that changes how the object READS without changing what it is, but
      it is camera state rather than a display setting, and native code keeps it
      with the camera pose.
    -->
    <item name="projection_perspective" type="id" />
    <item name="projection_orthographic" type="id" />

    <!--
      View. What the viewport draws BESIDES the model. Two working controls
      as of `SEL-OUT-R1`: the world reference grid, and the selected body's
      persistent silhouette outline. The group exists rather than the chips
      standing alone because both are view references over the same model.
      Nothing disabled or fake is drawn here: a control the product cannot
      honour yet has no home in this group.
    -->
    <item name="view_grid_on" type="id" />
    <item name="view_grid_off" type="id" />
    <item name="view_selection_outline_on" type="id" />
    <item name="view_selection_outline_off" type="id" />

    <!--
      The expanded window's Objects column. It HOSTS the one Objects section;
      objects_section and object_row keep naming the same views wherever that
      section is currently parented, which is what lets verification reach a
      body by its ObjectId without caring about the layout mode.
    -->
    <item name="objects_dock" type="id" />

    <!--
      The Objects panel every window that has NOT earned a column uses instead.
      It names a HOST: the one Objects section moves between this panel and
      objects_dock, so objects_section and object_row keep meaning the same
      views in either.
    -->
    <item name="objects_popover" type="id" />

    <!--
      The Objects capsule: the resting scene control, and the main entry to the
      scene on a phone. It names which body is active and carries the one
      creation affordance, and both surfaces it opens are anchored to it rather
      than to a window edge.

      There is no toolbar Objects button any more. A second control opening the
      same panel would be a second answer to "where does the scene live", and
      the capsule is the one that can also SAY which body is current.
    -->
    <item name="objects_capsule" type="id" />
    <item name="objects_capsule_active" type="id" />
    <item name="objects_capsule_add" type="id" />

    <!--
      Construction history. Two icon controls in one capsule at the trailing end
      of the bottom row, opposite the Objects capsule: what the project IS on the
      leading side, what just happened to it on the trailing one.

      They are Construction's, not the shell's: they are withdrawn entirely in
      Sculpt, because a control that reads as Undo while a sculpt stroke is the
      last thing the user did would be claiming to undo the stroke.
    -->
    <item name="history_group" type="id" />
    <item name="undo_action" type="id" />
    <item name="redo_action" type="id" />

    <!--
      Add Primitive: the creation surface a `+` opens, in either Objects host.

      Exactly six options, one per primitive the product actually builds. There
      is deliberately no Add-from-file entry, no import, no template and no
      disabled placeholder: a creation action the product cannot honour has no
      home here. A later creation CATEGORY arrives as a second group inside this
      surface, which is why the palette owns its own layout rather than being a
      row of chips inside the Objects list.
    -->
    <item name="add_primitive_palette" type="id" />
    <item name="add_primitive_box" type="id" />
    <item name="add_primitive_cylinder" type="id" />
    <item name="add_primitive_sphere" type="id" />
    <item name="add_primitive_cone" type="id" />
    <item name="add_primitive_capsule" type="id" />
    <item name="add_primitive_plane" type="id" />
    <!-- The second creation category (CAD-R0-A1A2): a sketch on a workplane.
         The tile opens the plane chooser inside the same palette; a sketch
         begins only once a plane has been chosen, and a body exists only once
         the sketch has been extruded. -->
    <item name="add_sketch" type="id" />
    <item name="sketch_plane_chooser" type="id" />
    <item name="sketch_plane_xy" type="id" />
    <item name="sketch_plane_xz" type="id" />
    <item name="sketch_plane_yz" type="id" />
    <item name="sketch_plane_back" type="id" />
    <item name="sketch_support_spatial" type="id" />
    <!-- The by-name plane list is the accessibility fallback (UI-OWNER-46):
         New Sketch itself lands directly in the spatial chooser, and this
         secondary control is how the three named planes are still reached. -->
    <item name="sketch_plane_by_name" type="id" />
    <!-- Project actions (APP-H1): start a new project from an open one. -->
    <item name="project_new" type="id" />

    <!--
      The presentation-only host for the complete trailing context cluster.
      Its stable child ids let verification describe the host contract without
      depending on incidental child order.
    -->
    <item name="workspace_trailing_host" type="id" />
    <item name="tool_rail_scroll" type="id" />
    <item name="precision_group" type="id" />
    <item name="transform_selector_row" type="id" />

    <!-- Tool Rail. One rail view; its entries differ by mode. -->
    <item name="tool_rail" type="id" />
    <item name="tool_rail_grab" type="id" />
    <item name="tool_rail_clay" type="id" />
    <item name="tool_rail_smooth" type="id" />
    <item name="tool_rail_inflate" type="id" />
    <item name="tool_rail_shape" type="id" />
    <item name="tool_rail_place" type="id" />
    <!-- The five sketch tools (CAD-R0-A1A2). Select is a tool so that a tap in
         the viewport has exactly one meaning at a time. -->
    <item name="tool_rail_select" type="id" />
    <item name="tool_rail_line" type="id" />
    <item name="tool_rail_polyline" type="id" />
    <item name="tool_rail_rectangle" type="id" />
    <item name="tool_rail_circle" type="id" />
    <item name="tool_rail_arc" type="id" />
    <item name="tool_rail_spline" type="id" />
    <!-- The sketch's own group under the rail: the way out of a sketch that
         keeps nothing, and the way back from the profile choice to editing.
         Both act on the one native sketch session. -->
    <item name="sketch_group" type="id" />
    <item name="cancel_sketch" type="id" />
    <item name="back_to_sketch" type="id" />

    <!--
      The precision toggle: the one contextual action that opens the exact-value
      surface for whatever the rail is currently holding. Attached to the rail
      rather than living in the Global Toolbar, because what it opens depends
      entirely on the held tool — and because the surface it opens grows out of
      it.
    -->
    <item name="precision_toggle" type="id" />

    <!--
      The Move / Rotate selector, anchored to the trailing tool cluster and
      present only while Transform is the held Construction context.

      These name the ACT — which kind of direct manipulation the axis handles
      perform — and not the label, so copy can never rename one. The group id
      exists so verification can ask whether the selector is on screen at all
      without inferring it from one of its buttons.
    -->
    <item name="transform_mode_group" type="id" />
    <item name="transform_mode_move" type="id" />
    <item name="transform_mode_rotate" type="id" />
    <item name="transform_mode_scale" type="id" />
    <item name="transform_space_group" type="id" />
    <item name="transform_space_world" type="id" />
    <item name="transform_space_local" type="id" />

    <!-- Direct Sculpt brush controls -->
    <item name="brush_edge_controls" type="id" />
    <item name="brush_radius_slider" type="id" />
    <item name="brush_strength_slider" type="id" />
    <item name="brush_radius_value" type="id" />
    <item name="brush_strength_value" type="id" />

    <!-- Property Inspector: the on-demand precision surface. -->
    <item name="property_inspector" type="id" />
    <!-- Closes the precision surface outright. It is not a collapse control:
         a closed precision surface leaves nothing behind at all, which is the
         whole reason the resting workspace has no bottom panel. -->
    <item name="inspector_toggle" type="id" />
    <item name="inspector_title" type="id" />
    <item name="inspector_scroll" type="id" />
    <!-- The pinned commit below the scrolling body: Apply never scrolls away. -->
    <item name="inspector_footer" type="id" />
    <item name="inspector_body" type="id" />

    <!-- Construction: shape -->
    <item name="primitive_chooser" type="id" />
    <item name="primitive_option_box" type="id" />
    <item name="primitive_option_cylinder" type="id" />
    <item name="primitive_option_sphere" type="id" />
    <item name="primitive_option_cone" type="id" />
    <item name="primitive_option_capsule" type="id" />
    <item name="primitive_option_plane" type="id" />
    <item name="primitive_row_box" type="id" />
    <item name="primitive_row_cylinder" type="id" />
    <item name="primitive_row_sphere" type="id" />
    <item name="primitive_row_cone" type="id" />
    <item name="primitive_row_capsule" type="id" />
    <item name="primitive_row_plane" type="id" />
    <item name="field_box_width" type="id" />
    <item name="field_box_height" type="id" />
    <item name="field_box_depth" type="id" />
    <item name="field_cylinder_diameter" type="id" />
    <item name="field_cylinder_height" type="id" />
    <item name="field_sphere_diameter" type="id" />
    <item name="field_cone_diameter" type="id" />
    <item name="field_cone_height" type="id" />
    <item name="field_capsule_diameter" type="id" />
    <item name="field_capsule_total_height" type="id" />
    <item name="field_plane_width" type="id" />
    <item name="field_plane_depth" type="id" />
    <item name="apply_shape" type="id" />

    <!-- Construction: placement -->
    <item name="field_pos_x" type="id" />
    <item name="field_pos_y" type="id" />
    <item name="field_pos_z" type="id" />
    <item name="field_rot_x" type="id" />
    <item name="field_rot_y" type="id" />
    <item name="field_rot_z" type="id" />
    <item name="field_scale_x" type="id" />
    <item name="field_scale_y" type="id" />
    <item name="field_scale_z" type="id" />
    <item name="apply_transform" type="id" />

    <!-- Display unit. Shared by both Construction inspector bodies. -->
    <item name="unit_chips" type="id" />
    <item name="unit_chip_mm" type="id" />
    <item name="unit_chip_cm" type="id" />
    <item name="unit_chip_m" type="id" />

    <!-- Sculpt context -->
    <item name="sculpt_mesh_summary" type="id" />
    <item name="stale_source_warning" type="id" />
    <item name="freeze_again" type="id" />

    <!-- Objects: the scene's Construction Bodies. Every row carries the same
         `object_row` id and identifies WHICH body by its tag (the ObjectId),
         because a per-body id cannot exist at build time. -->
    <item name="objects_section" type="id" />
    <item name="objects_list" type="id" />
    <item name="object_row" type="id" />
    <!-- The row's Delete affordance (UI-OWNER-45). A sibling of the row's
         label, not the row itself, so selecting a body and removing it are two
         separate targets and neither can be reached by mistake. It carries the
         same ObjectId tag the label does. -->
    <item name="object_row_delete" type="id" />
    <!-- Stage 018A object commands. Every one of them carries the same
         ObjectId tag the row label does, and each names the ACT the code
         performs rather than the label it wears: `object_row_visibility` is
         one control whose glyph and content description say Show or Hide, so
         copy can never rename an id.

         `object_row_more` opens the row's own command strip INLINE, beneath
         the row, rather than adding four more targets to a 220 dp row. The
         strip is the compact contextual surface this product already speaks
         in; Delete deliberately stays on the row itself, exactly where
         `UI-OWNER-45` put it. -->
    <item name="object_row_more" type="id" />
    <item name="object_row_commands" type="id" />
    <item name="object_row_rename" type="id" />
    <item name="object_row_visibility" type="id" />
    <item name="object_row_lock" type="id" />
    <item name="object_row_duplicate" type="id" />
    <!-- Mirror (`MIRROR-01`): the row command, and the compact plane chooser it
         grows in place of the strip. The chooser is a CHOICE and not yet an
         act: System Back closes it and mutates nothing, exactly as the rename
         editor's Back does. -->
    <item name="object_row_mirror" type="id" />
    <item name="object_mirror_planes" type="id" />
    <item name="object_mirror_plane_xy" type="id" />
    <item name="object_mirror_plane_xz" type="id" />
    <item name="object_mirror_plane_yz" type="id" />
    <!-- The inline rename editor: the field the user types in and the control
         that commits it. IME Done commits too; System Back cancels. -->
    <item name="object_rename_field" type="id" />
    <item name="object_rename_commit" type="id" />
    <!-- The column host's own creation affordance. The same act as the
         capsule's `+`: it opens Add Primitive, and never creates a body by
         itself. -->
    <item name="add_body" type="id" />

    <!--
      The sketch (CAD-R0-A1A2).

      Two toolbar transitions, one per sketch state, each the ONE way forward
      from that state: Finish Sketch while editing, Extrude once a profile is
      ready. Neither has an abbreviated form.
    -->
    <item name="finish_sketch" type="id" />
    <item name="extrude_sketch" type="id" />

    <!-- The sketch's precision surface: the selected entity's exact values
         while editing, and the profile, depth and direction once finished. -->
    <item name="sketch_editor" type="id" />
    <item name="sketch_entity_row_rectangle" type="id" />
    <item name="sketch_entity_row_circle" type="id" />
    <item name="sketch_entity_row_line" type="id" />
    <item name="sketch_entity_summary" type="id" />
    <item name="field_sketch_rect_width" type="id" />
    <item name="field_sketch_rect_height" type="id" />
    <item name="field_sketch_circle_radius" type="id" />
    <item name="field_sketch_line_x0" type="id" />
    <item name="field_sketch_line_y0" type="id" />
    <item name="field_sketch_line_x1" type="id" />
    <item name="field_sketch_line_y1" type="id" />
    <item name="apply_sketch_entity" type="id" />
    <item name="delete_sketch_entity" type="id" />
    <item name="sketch_profile_chooser" type="id" />
    <!-- Every profile chip carries this id; which profile it means is its tag,
         the anchor entity id, exactly as an Objects row carries its ObjectId. -->
    <item name="sketch_profile_option" type="id" />
    <item name="field_extrude_depth" type="id" />
    <item name="extrude_direction_along" type="id" />
    <item name="extrude_direction_against" type="id" />
    <!-- The same act as the toolbar's Extrude, pinned under the depth field so
         the number and the commit are one gesture apart. -->
    <item name="sketch_extrude_commit" type="id" />

    <!-- A CAD Body's own exact-value editor: the profile's sizes, the depth
         and the direction, and one Apply that is one history step. -->
    <item name="cad_editor" type="id" />
    <item name="cad_plane_summary" type="id" />
    <item name="cad_profile_summary" type="id" />
    <item name="cad_row_rectangle" type="id" />
    <item name="cad_row_circle" type="id" />
    <item name="field_cad_rect_width" type="id" />
    <item name="field_cad_rect_height" type="id" />
    <item name="field_cad_circle_radius" type="id" />
    <item name="field_cad_depth" type="id" />
    <item name="cad_direction_along" type="id" />
    <item name="cad_direction_against" type="id" />
    <item name="apply_cad" type="id" />
    <item name="edit_cad_sketch" type="id" />

    <!-- Body Dimensions and Relative Scale (Stage 020M). Each id names the ACT
         the code performs, never the label, so copy can be rewritten without
         renaming a control. -->
    <item name="body_size_group" type="id" />
    <item name="body_dimensions" type="id" />
    <item name="body_relative_scale" type="id" />
    <item name="dimension_anchor_group" type="id" />
    <item name="dimension_anchor_negative" type="id" />
    <item name="dimension_anchor_center" type="id" />
    <item name="dimension_anchor_positive" type="id" />
    <!-- The three numeric labels over the viewport, one per body axis, and the
         compact editor one of them opens. -->
    <item name="body_dimension_labels" type="id" />
    <item name="body_dimension_label_x" type="id" />
    <item name="body_dimension_label_y" type="id" />
    <item name="body_dimension_label_z" type="id" />
    <item name="body_dimension_editor" type="id" />
    <item name="field_body_dimension" type="id" />
    <item name="apply_body_dimension" type="id" />
    <!-- The Relative Scale precision-surface body: three multipliers that open
         at 1 every time, and one Apply that is one history step. -->
    <item name="relative_scale_editor" type="id" />
    <item name="field_relative_scale_x" type="id" />
    <item name="field_relative_scale_y" type="id" />
    <item name="field_relative_scale_z" type="id" />
    <item name="apply_relative_scale" type="id" />
</resources>
