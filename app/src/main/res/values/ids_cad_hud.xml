<?xml version="1.0" encoding="utf-8"?>
<!--
  Stable semantic ids for the compact CAD extrude HUD and the Tool Labels
  preference. Kept in their own file so the HUD's test contract can be read in
  one place; every id names what the control DOES, never where it sits or what
  its caption says (see ids.xml for why).

  The HUD's older ids — cad_extrude_canvas, cad_extrude_depth_value, the
  editors, cad_extrude_flip, the three cad_extrude_extent_* choices and
  cad_canvas_edit_sketch — stay in ids.xml and keep naming the same acts.
-->
<resources>
    <!-- The ONE action dock past the arrow's point
         (CAD-V6-S2-OWNER-CORRECTION-E2E-R1): the operation badge drawn into
         native's projected quad, and the act of opening the action palette.
         The id kept its name because the act did not change; cad_extrude_flip
         names the Flip act in the palette. -->
    <item name="cad_extrude_panel" type="id" />
    <!-- The action palette the panel opens: extent, operation and Flip rows. -->
    <item name="cad_extrude_actions_palette" type="id" />
    <item name="cad_extrude_extent_palette" type="id" />
    <item name="cad_extrude_operation_palette" type="id" />
    <item name="cad_extrude_operation_new_body" type="id" />
    <item name="cad_extrude_operation_add" type="id" />
    <item name="cad_extrude_operation_cut" type="id" />

    <!-- Settings page, Interface group: whether icon controls carry captions. -->
    <item name="tool_labels_off" type="id" />
    <item name="tool_labels_on" type="id" />
</resources>
