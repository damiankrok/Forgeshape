<?xml version="1.0" encoding="utf-8"?>
<!--
  The compact CAD extrude HUD's metrics.

  The glyph and value-text sizes are NOT here: they follow the camera-attached
  multiplier native reports and are computed by CadHudPresentation (a glyph is
  28 dp x clamp(scale, 0.40, 1.60), the value clamp(14 sp x scale, 11, 18)),
  where a JVM case holds them. What is here is what does not move with the
  camera: the palettes' metrics. Every touch target is an invisible 48 dp
  proxy at every scale, so the floor is the HIT AREA and never the glyph — the
  rule dimens.xml states for the whole product. Since CAD-FOUNDATION-C1 the
  value is plain text above the extrude leader and wears no pill.
-->
<resources>
    <!-- The palettes' capsules: 2 dp around their 48 dp members, rather than
         the toolbar's 4 dp, and no gap between members. The members are
         borderless at rest, so adjacent 48 dp hit rectangles still read as
         separate glyphs. -->
    <dimen name="cad_hud_capsule_padding">2dp</dimen>
    <!-- A member's corner, concentric with the capsule: the capsule's 26 dp
         corner minus the 2 dp between the two edges — inner = outer - gap. -->
    <dimen name="cad_hud_member_radius">24dp</dimen>
    <!-- Horizontal breathing room around a caption, when Tool Labels is on. -->
    <dimen name="cad_hud_caption_padding_horizontal">6dp</dimen>
    <!-- Between a glyph and the caption under it. -->
    <dimen name="cad_hud_caption_gap">1dp</dimen>
    <!-- The smallest vertical padding a captioned control keeps, top and bottom. -->
    <dimen name="cad_hud_caption_padding_vertical_min">2dp</dimen>
    <!-- The numeric editors' surface padding. 8 dp so a 10 dp field corner is
         concentric with the 18 dp context surface around it. -->
    <dimen name="cad_hud_editor_padding">8dp</dimen>
</resources>
