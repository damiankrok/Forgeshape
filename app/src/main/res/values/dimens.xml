<?xml version="1.0" encoding="utf-8"?>
<!--
  Editor Workspace metrics.

  Every touch target here is at or above 44 dp in its short dimension. That is
  the stylus-first constraint (INPUT-OWNER-01) expressed as a number: an S Pen
  tip is precise, a fingertip is not, and the shell has to stay usable with
  both without growing a second set of controls.

  Spacing follows a 4 dp grid. Values that are not on it are local arithmetic
  (a stroke width, an icon's optical size), never a gap between two surfaces.
-->
<resources>
    <!-- =====================================================================
         Corner radius: three semantic levels, not one number.

         A single radius on both a 44 dp chip and a 360 dp panel is what made
         every surface read as the same flat card. The level says what KIND of
         thing is being drawn, so a control never has to guess.
         ===================================================================== -->
    <!-- A thing you press: chip, field, button, rail entry, object row. -->
    <dimen name="radius_control">10dp</dimen>
    <!-- A surface that floats over the model: rail, popover, brush controls. -->
    <dimen name="radius_floating">18dp</dimen>
    <!-- A panel or sheet that carries a whole body of content. -->
    <dimen name="radius_sheet">24dp</dimen>

    <!-- =====================================================================
         Depth. Only surfaces that genuinely float get any, and none of them
         gets much: a heavy shadow over a rendered model reads as dirt on the
         screen. A DOCKED inspector deliberately has none — it is beside the
         model, not above it, and a card shadow would be a lie about the layout.
         ===================================================================== -->
    <dimen name="elevation_floating">6dp</dimen>
    <dimen name="elevation_sheet">10dp</dimen>
    <dimen name="elevation_chooser">16dp</dimen>

    <!-- =====================================================================
         Typography: five roles plus the rail's own caption.

         These were five loose sizes before. Naming them by role is what lets a
         caller ask for "a value" or "a caption" instead of picking a number,
         and it is what a Light theme will not have to re-argue.
         ===================================================================== -->
    <!-- The start chooser's headline. The only prominent type in the product. -->
    <dimen name="text_display">21sp</dimen>
    <!-- A surface's own name: toolbar context, inspector title, option title. -->
    <dimen name="text_title">15sp</dimen>
    <!-- An exact value being typed. Larger than body on purpose. -->
    <dimen name="text_value">16sp</dimen>
    <!-- The default: chips, buttons, rail entries, summaries. -->
    <dimen name="text_body">14sp</dimen>
    <!-- Status lines, option descriptions, secondary prose. -->
    <dimen name="text_caption">12sp</dimen>
    <!-- Section headings and field captions. -->
    <dimen name="text_label">11sp</dimen>

    <!-- Extra leading for anything that can wrap to a second line. -->
    <dimen name="text_line_spacing">3dp</dimen>

    <!-- Global Toolbar. One strip; its height is the only chrome height the
         viewport pays for at the top. -->
    <dimen name="toolbar_height">48dp</dimen>
    <dimen name="toolbar_padding_horizontal">10dp</dimen>
    <!-- 6dp rather than 8dp. The row carries one transition button, Export and
         three icon controls on a 411 dp window, and the icon controls no longer
         draw a box of their own — so the gaps are what separate them and they
         no longer have to clear two adjacent borders. -->
    <dimen name="toolbar_gap">6dp</dimen>
    <!-- How wide the editing-context label may grow before it ellipsises. It
         absorbs the squeeze so no action button is ever clipped on a narrow
         window, which is why it is a shared contract and not a local number. -->
    <dimen name="toolbar_context_max_width">152dp</dimen>
    <!--
      How wide a mode-transition button (Freeze / Resume / Back) may grow.

      The context label absorbs squeeze first, but a COMPACT window withdraws it
      outright — and with it gone, the row's next-widest child was an unbounded
      wrap-content button. "Back to Construction" measured wider than the space
      left, so the LAST child took the squeeze and the Hide UI control was drawn
      clipped by the window edge, below the touch floor and partly unreachable.
      Bounded here, the button ellipsises instead and every icon control keeps
      the size it asked for. Wide enough for "Freeze to Sculpt" in full.
    -->
    <dimen name="toolbar_transition_max_width">156dp</dimen>

    <!-- Tool Rail. 56 x 64 dp per entry: comfortably past the 44 dp floor with
         room for a label under the icon, because icon-only costs learning. -->
    <dimen name="rail_item_width">56dp</dimen>
    <dimen name="rail_item_height">64dp</dimen>
    <!-- 2dp rather than 4dp. Entries are borderless at rest now, so the gap is
         no longer separating two drawn boxes — it is only keeping the ACTIVE
         entry's shape off its neighbours, and a wide gap made one rail read as
         a stack of separate cards. -->
    <dimen name="rail_item_gap">2dp</dimen>
    <dimen name="rail_padding">6dp</dimen>
    <dimen name="rail_icon_size">22dp</dimen>
    <dimen name="rail_label_size">10sp</dimen>

    <!-- Brush edge controls: the two continuously-varied Sculpt values. The
         track is deliberately wider than it looks so a thumb can find it. -->
    <dimen name="brush_column_width">52dp</dimen>
    <dimen name="brush_slider_height">200dp</dimen>
    <dimen name="brush_slider_min_height">120dp</dimen>
    <dimen name="brush_track_width">10dp</dimen>
    <!-- The slider's TOUCH width, which is deliberately much wider than the
         track it draws. Named rather than computed from the track, so the hit
         area cannot shrink by accident when the track is restyled. -->
    <dimen name="brush_touch_width">32dp</dimen>
    <dimen name="brush_thumb_radius">11dp</dimen>
    <dimen name="brush_gap">8dp</dimen>

    <!-- Property Inspector. -->
    <dimen name="inspector_handle_height">44dp</dimen>
    <dimen name="inspector_padding">12dp</dimen>
    <dimen name="inspector_side_width">320dp</dimen>
    <dimen name="inspector_side_overlay_width">360dp</dimen>
    <dimen name="inspector_max_sheet_height">300dp</dimen>

    <!-- Controls. -->
    <dimen name="control_height">44dp</dimen>
    <dimen name="control_border_width">1dp</dimen>
    <dimen name="control_border_active_width">2dp</dimen>
    <dimen name="control_padding_horizontal">14dp</dimen>
    <dimen name="chip_padding_horizontal">12dp</dimen>
    <!-- An icon-only control: square, and still at the 44 dp touch floor. -->
    <dimen name="icon_button_size">44dp</dimen>
    <dimen name="icon_size">20dp</dimen>

    <!-- Exact-value field padding. Shared by every numeric row in the product,
         so the fields in the shape editor and the placement editor cannot
         drift apart the way they did while each carried its own numbers. -->
    <dimen name="field_padding_horizontal">12dp</dimen>
    <dimen name="field_padding_vertical">8dp</dimen>

    <dimen name="row_gap">8dp</dimen>
    <dimen name="row_gap_small">4dp</dimen>
    <!-- 18dp rather than 12dp. This is the only gap in the inspector that
         separates one QUESTION from the next — which primitive, what size, in
         what unit — and at 12dp it was barely larger than the 8dp between two
         rows inside a section, so every panel read as one undifferentiated
         stack. Section spacing is the cheapest hierarchy in the product and it
         was the one thing not being spent on. -->
    <dimen name="section_gap">18dp</dimen>

    <!-- The Objects panel, in windows that have not earned a column of their
         own. Fixed rather than proportional for the same reason the docked
         column is: its content does not scale with the window — a row reads
         "Body #7" and Add Body is one chip — so a proportional width would buy
         whitespace with viewport. Wider than the 180dp column because this one
         stands ON the model rather than beside it, and a panel that overlays
         the picture should at least be comfortable to hit. -->
    <dimen name="objects_popover_width">220dp</dimen>

    <!-- Start chooser. -->
    <dimen name="chooser_padding">24dp</dimen>
    <dimen name="chooser_max_width">440dp</dimen>
    <dimen name="chooser_option_padding">16dp</dimen>
    <dimen name="chooser_option_icon_size">28dp</dimen>
</resources>
