<?xml version="1.0" encoding="utf-8"?>
<!--
  Editor Workspace metrics.

  Every user-operated touch target here is at or above 48 dp in its short
  dimension. That is the stylus-first constraint (INPUT-OWNER-01) expressed as a
  number, raised from 44 dp at UI-R4B: an S Pen tip is precise, a fingertip is
  not, and the shell has to stay usable with both without growing a second set
  of controls. The floor is the HIT AREA and never the glyph — an icon still
  reads at 20 dp inside a 48 dp control, and nothing here grows a drawn box to
  reach the number.

  Spacing follows a 4 dp grid. Values that are not on it are local arithmetic
  (a stroke width, an icon's optical size), never a gap between two surfaces.
-->
<resources>
    <!-- =====================================================================
         Corner radius: three semantic levels, not one number.

         A single radius on both a 48 dp chip and a 360 dp panel is what made
         every surface read as the same flat card. The level says what KIND of
         thing is being drawn, so a control never has to guess.
         ===================================================================== -->
    <!-- A thing you press: chip, field, button, rail entry, object row. -->
    <dimen name="radius_control">10dp</dimen>
    <!-- A surface that floats over the model: rail, popover, brush controls. -->
    <dimen name="radius_floating">18dp</dimen>
    <!-- A panel or sheet that carries a whole body of content. -->
    <dimen name="radius_sheet">24dp</dimen>
    <!-- A floating control GROUP: a capsule holding two or three controls that
         belong together. Large enough that a 56 dp-tall group reads as a pill
         rather than as a rounded rectangle, which is the difference between a
         group of controls and a small panel. -->
    <dimen name="radius_capsule">26dp</dimen>
    <!--
      A control that lives INSIDE a floating capsule: an icon control, the
      Objects capsule's body label, a mode-transition button, Export.

      CONCENTRIC with its host, and that is the whole reason it exists. A 10 dp
      corner painted flush inside a 26 dp capsule leaves a crescent of capsule
      showing at each end, because the two arcs do not share a centre — which is
      what made an active icon control read as a box dropped into a pill rather
      than as the pill's own selected state. The rule is inner = outer minus the
      gap between them: a 26 dp capsule with 4 dp of group padding takes a 22 dp
      control.
    -->
    <dimen name="radius_control_inset">22dp</dimen>
    <!--
      A Tool Rail entry, by the same rule. The rail wears the Tier 1 floating
      capsule (radius_capsule) like every other control group, with 6 dp of
      padding around its entries, so an entry is concentric with it at 20 dp.
    -->
    <dimen name="radius_rail_entry">20dp</dimen>

    <!-- =====================================================================
         Depth. Only surfaces that genuinely float get any, and none of them
         gets much: a heavy shadow over a rendered model reads as dirt on the
         screen. A DOCKED inspector deliberately has none — it is beside the
         model, not above it, and a card shadow would be a lie about the layout.
         ===================================================================== -->
    <dimen name="elevation_floating">6dp</dimen>
    <dimen name="elevation_sheet">10dp</dimen>
    <dimen name="elevation_chooser">16dp</dimen>

    <!-- =====================================================================
         Typography: five roles plus the rail's own caption.

         These were five loose sizes before. Naming them by role is what lets a
         caller ask for "a value" or "a caption" instead of picking a number,
         and it is what a Light theme will not have to re-argue.
         ===================================================================== -->
    <!-- The start chooser's headline. The only prominent type in the product. -->
    <dimen name="text_display">21sp</dimen>
    <!-- A surface's own name: toolbar context, inspector title, option title. -->
    <dimen name="text_title">15sp</dimen>
    <!-- An exact value being typed. Larger than body on purpose. -->
    <dimen name="text_value">16sp</dimen>
    <!-- The default: chips, buttons, rail entries, summaries. -->
    <dimen name="text_body">14sp</dimen>
    <!-- Status lines, option descriptions, secondary prose. -->
    <dimen name="text_caption">12sp</dimen>
    <!-- Section headings and field captions. -->
    <dimen name="text_label">11sp</dimen>

    <!-- Extra leading for anything that can wrap to a second line. -->
    <dimen name="text_line_spacing">3dp</dimen>

    <!--
      Global Toolbar.

      NOT a strip any more. The toolbar container is transparent and what the
      user sees is two floating control GROUPS with the model between and behind
      them — an editing group on the leading edge and a utility group on the
      trailing one. A full-width opaque bar with a hairline under it is the one
      shape that says "Android app bar" no matter what colour it is painted, and
      the workspace is meant to read as one spatial composition rather than as a
      document editor with a title bar.

      `toolbar_height` is the height of the control ROW inside that container,
      which is what the two hanging popovers are still anchored under.
    -->
    <dimen name="toolbar_height">56dp</dimen>
    <dimen name="toolbar_padding_horizontal">8dp</dimen>
    <!-- The breathing room inside a control group's capsule, around the 48 dp
         controls it holds. -->
    <dimen name="toolbar_group_padding">4dp</dimen>
    <!-- 4dp rather than 6dp. Inside a control group's own capsule the gap is
         separating two borderless controls that already share a material, so it
         only has to keep their touch targets apart — and the row still has to
         fit one transition button, Export and two icon controls on a 411 dp
         window. -->
    <dimen name="toolbar_gap">4dp</dimen>
    <!-- How wide the editing-context label may grow before it ellipsises. It
         absorbs the squeeze so no action button is ever clipped on a narrow
         window, which is why it is a shared contract and not a local number. -->
    <dimen name="toolbar_context_max_width">152dp</dimen>
    <!--
      The FLOOR a mode-transition button (Start Sculpting / Resume / Back) is
      given, not a cap.

      How wide it may actually grow is arithmetic on the row it is in — see
      GlobalToolbarView#fitTransitionToRow — because a single dp constant cannot
      be right in three windows at once. It was one: sized against the narrowest
      window the product supports and then applied to every window, so "Back to
      Construction" read "Back to Constructi…" on a phone, on a short landscape
      window AND on a tablet, all three with room to spare. Critical navigation
      may not be guessed at, and the row can carry it.

      What survives is the priority the cap existed for, and it is unchanged: an
      icon control never gives up width, because one squeezed below the touch
      floor is unreachable, while a transition button that gives some up still
      reads. Below this floor the budget stops shrinking and the button takes
      its short form instead. `R1B1-10b`, `UIR3-01` and `UIR4B-17` are what hold
      it honest: all three measure the icon controls' real width AND their right
      edge.
    -->
    <dimen name="toolbar_transition_min_width">96dp</dimen>
    <!--
      What an INLINE status message keeps of the control row.

      On a short window the message shares the row with the two control groups
      instead of getting a line of its own, so it competes with the transition
      button for the same width. Reserved rather than left to a weight: the slot
      is the row's flexible child, and a flexible child of a row that has run out
      measures to nothing — which would silently drop a rejection on exactly the
      window with no second line to put it on. Only reserved while the line has
      something to say; an empty status is no capsule at all.
    -->
    <dimen name="toolbar_status_min_width">120dp</dimen>

    <!-- Tool Rail. 56 x 64 dp per entry: comfortably past the 48 dp floor with
         room for a label under the icon, because icon-only costs learning. -->
    <dimen name="rail_item_width">56dp</dimen>
    <dimen name="rail_item_height">64dp</dimen>
    <!-- 2dp rather than 4dp. Entries are borderless at rest now, so the gap is
         no longer separating two drawn boxes — it is only keeping the ACTIVE
         entry's shape off its neighbours, and a wide gap made one rail read as
         a stack of separate cards. -->
    <dimen name="rail_item_gap">2dp</dimen>
    <dimen name="rail_padding">6dp</dimen>
    <dimen name="rail_icon_size">22dp</dimen>
    <!--
      The icon size a SHORT window uses, and the reason the compact rail still
      has icons at all.

      A rail that drops to text-only in landscape is a different control from the
      one the user learned in portrait: the glyph is the part that is recognised
      at a glance, and losing it is a bigger regression than a smaller button.
      At 18 dp the icon and the 10 sp caption together measure inside the 48 dp
      compact entry with room to spare, so nothing has to be dropped.
    -->
    <dimen name="rail_icon_size_compact">18dp</dimen>
    <dimen name="rail_label_size">10sp</dimen>
    <!-- One 56 dp entry plus the right host's 6 dp inset on both sides. -->
    <dimen name="trailing_host_width">68dp</dimen>

    <!-- Brush edge controls: the two continuously-varied Sculpt values. The
         track is deliberately wider than it looks so a thumb can find it. -->
    <dimen name="brush_column_width">52dp</dimen>
    <dimen name="brush_slider_height">200dp</dimen>
    <dimen name="brush_slider_min_height">120dp</dimen>
    <dimen name="brush_track_width">10dp</dimen>
    <!-- The slider's TOUCH width, which is deliberately much wider than the
         10 dp track it draws. Named rather than computed from the track, so the
         hit area cannot shrink by accident when the track is restyled. At the
         48 dp floor it is a full-size target in its SHORT dimension, which is
         the dimension a thumb actually misses in — a 200 dp-tall column is not
         reachable if it is 32 dp wide. -->
    <dimen name="brush_touch_width">48dp</dimen>
    <dimen name="brush_thumb_radius">11dp</dimen>
    <dimen name="brush_gap">8dp</dimen>

    <!-- Property Inspector. -->
    <dimen name="inspector_handle_height">48dp</dimen>
    <dimen name="inspector_padding">14dp</dimen>
    <!--
      How far an INSET bottom sheet stands off the window edges.

      This is the whole difference between a panel and an attached slab. A sheet
      flush against three window edges reads as a platform bottom sheet dragged
      into a creative tool; the same content inset by a margin, with the viewport
      visible around it, reads as one more surface in the workspace — the same
      claim the Tool Rail and the toolbar's control groups already make.
    -->
    <dimen name="inspector_sheet_inset">8dp</dimen>
    <!--
      The fading bottom edge that says the body continues. Long enough to read
      as a fade rather than as a smudge, short enough that it never obscures a
      whole row: the panel already ends on a whole row, and this says there is
      another one under it.
    -->
    <dimen name="precision_scroll_fade">20dp</dimen>

    <!-- Controls. -->
    <dimen name="control_height">48dp</dimen>
    <dimen name="control_border_width">1dp</dimen>
    <dimen name="control_border_active_width">2dp</dimen>
    <dimen name="control_padding_horizontal">14dp</dimen>
    <!-- 10dp rather than 12dp. Chips are borderless at rest now, so the padding
         is no longer clearing a drawn outline — and six primitive chips sharing
         a narrow docked inspector three to a row need every dp to say their own
         names rather than "Cyl". -->
    <dimen name="chip_padding_horizontal">10dp</dimen>
    <!-- An icon-only control: square, and at the 48 dp touch floor. The GLYPH is
         still 20 dp; only the hit area carries the floor. -->
    <dimen name="icon_button_size">48dp</dimen>
    <dimen name="icon_size">20dp</dimen>

    <!-- Exact-value field padding. Shared by every numeric row in the product,
         so the fields in the shape editor and the placement editor cannot
         drift apart the way they did while each carried its own numbers. -->
    <dimen name="field_padding_horizontal">12dp</dimen>
    <dimen name="field_padding_vertical">8dp</dimen>

    <dimen name="row_gap">8dp</dimen>
    <dimen name="row_gap_small">4dp</dimen>
    <!-- 18dp rather than 12dp. This is the only gap in the inspector that
         separates one QUESTION from the next — which primitive, what size, in
         what unit — and at 12dp it was barely larger than the 8dp between two
         rows inside a section, so every panel read as one undifferentiated
         stack. Section spacing is the cheapest hierarchy in the product and it
         was the one thing not being spent on. -->
    <dimen name="section_gap">18dp</dimen>

    <!-- The Objects panel, in windows that have not earned a column of their
         own. Fixed rather than proportional for the same reason the docked
         column is: its content does not scale with the window — a row reads
         "Body #7" and Add Body is one chip — so a proportional width would buy
         whitespace with viewport. Wider than the 180dp column because this one
         stands ON the model rather than beside it, and a panel that overlays
         the picture should at least be comfortable to hit. -->
    <dimen name="objects_popover_width">220dp</dimen>

    <!--
      The Sculpt History navigator (SCULPT-H1).

      Narrower than the Objects panel because its rows carry far less: "Stroke
      12" and a marker, where an Objects row carries a body name and an
      overflow. 184 dp fits the longest row this list can produce at the
      largest supported system font without buying whitespace with viewport.

      How many rows are VISIBLE at once is not a dimension and is not here: see
      SculptHistoryNavigatorView.VISIBLE_ROWS, which is a viewport target and
      not a history bound — the retained branch is whatever SculptHistory kept,
      and the list scrolls over all of it.
    -->
    <dimen name="history_navigator_width">184dp</dimen>

    <!--
      The Add Primitive palette: six shape tiles, two to a row.

      Fixed rather than proportional for the same reason the Objects panel is —
      its content is six fixed tiles, so a proportional width would buy
      whitespace with viewport. Two columns rather than three because each tile
      carries a 28 dp silhouette above its name, and at three columns "Cylinder"
      no longer fits under its own icon on a 360 dp window.
    -->
    <dimen name="add_primitive_palette_width">268dp</dimen>
    <dimen name="add_primitive_tile_height">76dp</dimen>
    <dimen name="add_primitive_icon_size">26dp</dimen>

    <!--
      How far a surface stands off the control it grew out of.

      Every context surface in the workspace is anchored to its invoking control
      rather than to a window edge — the Objects panel and Add Primitive to a
      `+` or a capsule, the precision surface to the rail's precision toggle.
      This is the one gap between the two, so the relation reads as attachment
      rather than as two unrelated surfaces that happen to be near each other.
    -->
    <dimen name="overlay_anchor_gap">8dp</dimen>

    <!--
      The Objects capsule, the resting scene control.

      Sized to its own content, like every other floating capsule: it holds a
      body name and a `+`, and a fixed width would either clip "Body #12" or
      leave a bar across the bottom of the viewport — which is exactly the shape
      this stage removed.
    -->
    <dimen name="objects_capsule_max_label_width">148dp</dimen>

    <!-- Start chooser. -->
    <dimen name="chooser_padding">24dp</dimen>
    <dimen name="chooser_max_width">440dp</dimen>
    <dimen name="chooser_option_padding">16dp</dimen>
    <dimen name="chooser_option_icon_size">28dp</dimen>

    <!-- Start page (Home, New Project). A PAGE, so its margins are the
         window's rather than a card's, and its content is capped and centred
         on a wide window instead of stretching to the edges. -->
    <dimen name="start_page_padding">28dp</dimen>
    <dimen name="start_page_max_width">520dp</dimen>
    <dimen name="start_page_mark_size">40dp</dimen>
    <!-- The decorative corner motif's floor; it grows with the window. -->
    <dimen name="start_page_motif_size">200dp</dimen>

    <!-- The sketch orientation navigator (`SKETCH-UX-R1` C): a compact corner
         control, translucent, and standing clear of the Global Toolbar rather
         than under it. -->
    <dimen name="sketch_navigator_padding">8dp</dimen>
    <dimen name="sketch_navigator_top_margin">104dp</dimen>
    <dimen name="sketch_navigator_max_width">184dp</dimen>

    <!-- The dimension label's field: wide enough for a signed length in
         millimetres without becoming a panel over the drawing. -->
    <dimen name="sketch_dimension_field">96dp</dimen>

    <!-- The canvas extrude cluster's exact-value field (`CAD-UX-S1`). The
         cluster's own sizes live in dimens_cad_hud.xml since
         `CAD-VERTICAL-SLICE-R1`: its glyphs take the camera-attached scale and
         its 48dp hit areas do not. -->
    <dimen name="cad_canvas_field">88dp</dimen>
</resources>
