    <color name="p3_text_success">#FF7CC08C</color>

    <!-- DERIVED -->
    <color name="p3_surface_floating_translucent">#F053575A</color>
    <color name="p3_control_surface">#FF515557</color>
    <color name="p3_control_surface_pressed">#FF63676A</color>
    <color name="p3_control_border">#FF5F6366</color>
