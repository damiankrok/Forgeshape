         ===================================================================== -->
    <!-- APPROVED -->
    <color name="p2_viewport_background">#FF26282A</color>
    <color name="p2_chrome_surface">#FF2E3134</color>
    <color name="p2_surface_floating">#FF3A3E42</color>
