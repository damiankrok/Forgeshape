    <color name="p2_accent">#FF4C8FD6</color>
    <color name="p2_selected_rest">#FF384653</color>
    <color name="p2_text_measure">#FFDDA94F</color>
    <color name="p2_text_error">#FFF09A8E</color>
    <color name="p2_text_success">#FF74C58A</color>

    <!-- DERIVED -->
    <color name="p2_surface_floating_translucent">#F03A3E42</color>
    <color name="p2_control_surface">#FF383C41</color>
    <color name="p2_control_surface_pressed">#FF4A4F55</color>
    <color name="p2_control_border">#FF484D52</color>
    <color name="p2_field_surface">#FF292C2F</color>
    <color name="p2_selected_rest_pressed">#FF425264</color>
    <color name="p2_accent_border">#734C8FD6</color>
    <color name="p2_primary_fill_pressed">#FF6BA3DF</color>
    <color name="p2_text_on_primary">#FF101214</color>
    <color name="p2_text_disabled">#FF6C737A</color>
    <color name="p2_slider_track">#FF292C2F</color>
    <color name="p2_chooser_scrim">#99101214</color>

    <!-- =====================================================================
         PALETTE 03 — LIGHT CHARCOAL. The lightest dark.

         Past roughly this value a neutral clay render stops reading as lit and
         starts reading as washed out, which is the same failure a stark white
         canvas causes from the other direction.
         ===================================================================== -->
    <!-- APPROVED -->
    <color name="p3_viewport_background">#FF3C3F41</color>
    <color name="p3_chrome_surface">#FF45484A</color>
    <color name="p3_surface_floating">#FF53575A</color>
