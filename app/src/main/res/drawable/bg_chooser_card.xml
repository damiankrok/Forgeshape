<?xml version="1.0" encoding="utf-8"?>
<!-- One of the two start options. Pressed feedback, like every other control. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_fill" />
            <corners android:radius="@dimen/radius_floating" />
            <stroke
                android:width="@dimen/control_border_active_width"
                android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chooser_card_surface" />
            <corners android:radius="@dimen/radius_floating" />
            <stroke
                android:width="@dimen/control_border_width"
                android:color="@color/control_border" />
        </shape>
    </item>
</selector>
