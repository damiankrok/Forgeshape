<?xml version="1.0" encoding="utf-8"?>
<!--
  One of the two start options.

  Fill-led like every other control in the product: it is LIFTED off the panel
  it sits on and answers a press by lifting further, rather than sitting inside a
  permanent outlined box. Two outlined cards on an outlined panel was three
  nested frames for one question.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsAccentFill" />
            <corners android:radius="@dimen/radius_floating" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsChooserCardSurface" />
            <corners android:radius="@dimen/radius_floating" />
        </shape>
    </item>
</selector>
