<?xml version="1.0" encoding="utf-8"?>
<!--
  The exact extrusion value's pill in the canvas HUD.

  The VISIBLE pill is 32 dp tall and the control is 48 dp tall: the inset is
  what separates the two, so the value reads as a compact label on the model
  while its hit area still carries the 48 dp floor. A drawn box grown to 48 dp
  is exactly what the floor rule forbids.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="@dimen/cad_hud_value_pill_inset"
    android:insetBottom="@dimen/cad_hud_value_pill_inset">
    <selector>
        <item android:state_pressed="true">
            <shape android:shape="rectangle">
                <solid android:color="?attr/fsControlSurfacePressed" />
                <corners android:radius="@dimen/cad_hud_value_pill_radius" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="?attr/fsControlSurface" />
                <corners android:radius="@dimen/cad_hud_value_pill_radius" />
            </shape>
        </item>
    </selector>
</inset>
