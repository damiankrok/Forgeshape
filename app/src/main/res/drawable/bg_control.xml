<?xml version="1.0" encoding="utf-8"?>
<!--
  A control at rest: a chip, a display option, a unit.

  BORDERLESS, and tonal. The outline it used to draw was doing no work that the
  fill was not already doing: a chip sits on a surface one step darker than
  itself, and one step of tone plus the gap around it says "control" without
  putting a rectangle on the screen. Outlines are spent where an editing
  affordance genuinely needs one — see bg_field, which is the only resting
  control in the product that still draws a border.

  The pressed state is the point: before UI-R1B1, tapping a tool gave no feedback
  at all until native code answered.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsControlSurfacePressed" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsControlSurface" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
