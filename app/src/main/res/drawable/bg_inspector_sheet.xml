<?xml version="1.0" encoding="utf-8"?>
<!--
  The Property Inspector anchored to the BOTTOM edge.

  Only the leading corners are rounded. The trailing edge is the window edge,
  and rounding it would leave two slivers of viewport that read as a rendering
  fault rather than as a shape.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/fsChromeSurface" />
    <corners
        android:topLeftRadius="@dimen/radius_sheet"
        android:topRightRadius="@dimen/radius_sheet"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke
        android:width="@dimen/control_border_width"
        android:color="?attr/fsChromeHairline" />
</shape>
