<?xml version="1.0" encoding="utf-8"?>
<!--
  Back to Construction on a window whose editing group holds nothing else.

  The tonal form of bg_pill_primary, and the counterpart of bg_capsule_tonal:
  same quiet control fill, on the capsule's own radius because here the control
  is the capsule. See GlobalToolbarView#applyEditingComposition.

  A 1 dp HAIRLINE (`UI-CRAFT-R1`). Tone and a soft shadow alone left a
  translucent surface over a rendered model reading as a smudge rather than
  as an edge; the hairline, in the palette's own fsChromeHairline, is what
  every precision tool draws around a floating panel and is what makes the
  surface's corner crisp. It is a hairline and never a frame: 1 dp, at the
  low contrast the role was approved at.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsControlSurfacePressed" />
            <corners android:radius="@dimen/radius_capsule" />
            <stroke
                android:width="@dimen/control_border_width"
                android:color="?attr/fsChromeHairline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsControlSurface" />
            <corners android:radius="@dimen/radius_capsule" />
            <stroke
                android:width="@dimen/control_border_width"
                android:color="?attr/fsChromeHairline" />
        </shape>
    </item>
</selector>
