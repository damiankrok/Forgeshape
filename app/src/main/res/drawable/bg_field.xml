<?xml version="1.0" encoding="utf-8"?>
<!--
  An exact-value field.

  The focused state carries a thicker accent border rather than only a
  different colour, so which field the keyboard is about to type into is
  readable without relying on hue — and stays readable on a light theme, where
  the resting border is much closer in value to the surface it sits on.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsControlSurface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_active_width"
                android:color="?attr/fsAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsControlSurface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_width"
                android:color="?attr/fsControlBorder" />
        </shape>
    </item>
</selector>
