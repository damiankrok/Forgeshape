<?xml version="1.0" encoding="utf-8"?>
<!--
  An exact-value field.

  The focused state carries a thicker accent border rather than only a
  different colour, so which field the keyboard is about to type into is
  readable without relying on hue.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/control_surface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_active_width"
                android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/control_surface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_width"
                android:color="@color/control_border" />
        </shape>
    </item>
</selector>
