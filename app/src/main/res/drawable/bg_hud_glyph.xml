<?xml version="1.0" encoding="utf-8"?>
<!--
  A glyph attached to the extrude leader (`CAD-FOUNDATION-C1`): the extent
  control, the operation badge, Flip.

  Drawn on the GLYPH, never on its 48 dp touch proxy: the proxy is invisible,
  and this disc is exactly as large as the glyph the camera-attached scale
  sizes, so a pulled-back camera shows a small mark on the drawing rather than
  a 48 dp capsule. The floating tone keeps it findable over the model; a
  pressed or open control answers in the same shape the palette choices use.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="?attr/fsControlSurfacePressed" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="?attr/fsAccentFill" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/fsSurfaceFloating" />
        </shape>
    </item>
</selector>
