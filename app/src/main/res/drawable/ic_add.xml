<?xml version="1.0" encoding="utf-8"?>
<!--
  Create: add a new Construction Body to the scene.

  A bare plus rather than a plus inside a circle, because the control it sits in
  is already a shaped, tappable affordance in the Objects capsule — a ring
  around it would frame the same target twice.

  Drawn white and tinted at use; see EditorControlStyles.icon().
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M12,5 L12,19 M5,12 L19,12" />
</vector>
