<?xml version="1.0" encoding="utf-8"?>
<!--
  A primary commit: Apply Shape, Apply Transform, Freeze, Resume.

  The one solid accent block in the product, and it carries `fsTextOnPrimary` —
  a near-black ink rather than white, because #4C8FD6 is a bright accent on which
  white reads at 3.4:1 and ink reads at 5.5:1. The act that actually changes the
  model gets a label you can read.

  No stroke: the fill is already the loudest thing on its surface, and outlining
  it would only thicken it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsPrimaryFillPressed" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsPrimaryFill" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
