<?xml version="1.0" encoding="utf-8"?>
<!-- A primary commit: Apply Shape, Apply Transform, Freeze, Resume. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_width"
                android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_fill" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_width"
                android:color="@color/accent_border" />
        </shape>
    </item>
</selector>
