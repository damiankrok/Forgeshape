<?xml version="1.0" encoding="utf-8"?>
<!--
  Base chrome that is part of the WINDOW FRAME rather than standing on the model.

  Square and opaque on purpose: it spans a whole window edge. Borderless, because
  a surface flush against the frame is already separated from everything by the
  window itself.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/fsChromeSurface" />
</shape>
