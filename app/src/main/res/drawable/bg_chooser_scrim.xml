<?xml version="1.0" encoding="utf-8"?>
<!--
  The start chooser's backdrop.

  Partial rather than solid: the viewport keeps rendering behind it, so the
  first thing ForgeShape shows is still the model. A full-screen opaque page
  would be a launcher, and this product is viewport-first.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chooser_scrim" />
</shape>
