<?xml version="1.0" encoding="utf-8"?>
<!--
  The scene's bodies: several objects, one of them current.

  Stacked rows rather than a cube, because this opens a LIST of what the scene
  holds — the cube already means "shape" on the Tool Rail, and one symbol must
  not mean two things. The leading row is filled to say that one body is always
  the active one, which is the fact the list exists to change.

  Drawn white and tinted at use; see EditorControlStyles.icon().
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,4.5 L20,4.5 A1.5,1.5 0 0,1 20,7.5 L4,7.5 A1.5,1.5 0 0,1 4,4.5 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M5,12 L19,12" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M5,17.5 L19,17.5" />
</vector>
