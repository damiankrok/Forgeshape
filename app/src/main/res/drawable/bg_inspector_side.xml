<?xml version="1.0" encoding="utf-8"?>
<!--
  TIER 3 — the Property Inspector anchored to the TRAILING edge, docked or
  overlaid.

  Rounded on the side that faces the model, square against the window edge. Same
  opaque, borderless precision surface as the sheet.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/fsSurfacePrecision" />
    <corners
        android:topLeftRadius="@dimen/radius_sheet"
        android:bottomLeftRadius="@dimen/radius_sheet"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
