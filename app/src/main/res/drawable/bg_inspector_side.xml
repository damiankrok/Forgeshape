<?xml version="1.0" encoding="utf-8"?>
<!--
  The Property Inspector anchored to the TRAILING edge, docked or overlaid.

  Rounded on the side that faces the model, square against the window edge, for
  the same reason as the bottom sheet.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chrome_surface" />
    <corners
        android:topLeftRadius="@dimen/radius_sheet"
        android:bottomLeftRadius="@dimen/radius_sheet"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke
        android:width="@dimen/control_border_width"
        android:color="@color/chrome_hairline" />
</shape>
