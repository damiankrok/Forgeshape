<?xml version="1.0" encoding="utf-8"?>
<!--
  The stale-source warning block.

  It reports a state that persists until the user acts on it, so it gets a block
  of its own rather than a line of status text the next message would overwrite.
  This is one of the two places an outline is still spent — the other is a field
  — because "there is something wrong here" is exactly the kind of standing
  condition a tonal step alone under-states.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/fsFieldSurface" />
    <corners android:radius="@dimen/radius_control" />
    <stroke
        android:width="@dimen/control_border_width"
        android:color="?attr/fsTextMeasure" />
</shape>
