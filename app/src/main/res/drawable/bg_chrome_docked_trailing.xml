<?xml version="1.0" encoding="utf-8"?>
<!--
  Chrome DOCKED against the trailing window edge: the expanded window's Tool
  Rail.

  Same rule as bg_chrome_docked_leading, mirrored. It is deliberately a separate
  drawable from bg_inspector_side rather than a reuse of it: the two happen to
  want the same geometry today, and a shared file would make a later change to
  the inspector's corners silently restyle the rail.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/fsChromeSurface" />
    <corners
        android:topLeftRadius="@dimen/radius_sheet"
        android:bottomLeftRadius="@dimen/radius_sheet"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke
        android:width="@dimen/control_border_width"
        android:color="?attr/fsChromeHairline" />
</shape>
