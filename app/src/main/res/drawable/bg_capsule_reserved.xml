<?xml version="1.0" encoding="utf-8"?>
<!--
  A capsule member that names something the product does not have yet: the
  global Export.

  bg_control_reserved's recessed well, on the capsule's own concentric corner.
  The seam this fixes was visible: a 10 dp recessed rectangle sitting flush
  against the leading end of a 26 dp utility capsule left a lit crescent beside
  it, which read as a rendering fault rather than as a reserved control.

  Deliberately has NO pressed state. It is inert, and press feedback would
  suggest something happened.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/fsFieldSurface" />
    <corners android:radius="@dimen/radius_control_inset" />
</shape>
