<?xml version="1.0" encoding="utf-8"?>
<!--
  The active control: the held sculpt tool, the current Tool Rail entry, the
  active body's row, the drafted primitive.

  Active is never colour alone — a filled accent AND a thicker accent border AND
  a brightened label, so the current tool is unmistakable to someone who cannot
  separate the two blues.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_fill_pressed" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_active_width"
                android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_fill" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_active_width"
                android:color="@color/accent_border" />
        </shape>
    </item>
</selector>
