<?xml version="1.0" encoding="utf-8"?>
<!--
  The active control: the held sculpt tool, the current Tool Rail entry, the
  active body's row, the drafted primitive, the chosen theme.

  Active is never colour alone — a filled accent AND a thicker accent border AND
  a brightened label, so the current tool is unmistakable to someone who cannot
  separate the two blues, and so it still reads when the fill is a pale tint on
  a light theme rather than a solid block on a dark one.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsAccentFillPressed" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_active_width"
                android:color="?attr/fsAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsAccentFill" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_active_width"
                android:color="?attr/fsAccentBorder" />
        </shape>
    </item>
</selector>
