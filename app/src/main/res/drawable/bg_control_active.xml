<?xml version="1.0" encoding="utf-8"?>
<!--
  The selected control: the held sculpt tool, the current Tool Rail entry, the
  active body's row, the drafted primitive, the chosen appearance.

  FILL-LED. What says "this is the one you are on" is the surface itself —
  `fsAccentFill`, the palette's selected-at-rest value, which is clearly lifted
  and clearly cooler or bluer than the control beside it — plus the brightened
  label that comes with it from `control_content_tint`. The border is a hairline
  and is the THIRD signal rather than the first, so a selection reads as a state
  and not as an outlined box.

  It is deliberately NOT the accent. The accent is spent on a primary commit and
  on a focused field, and nowhere else; a selection that wore it made five loud
  blue blocks compete on one screen.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsAccentFillPressed" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsAccentFill" />
            <corners android:radius="@dimen/radius_control" />
            <stroke
                android:width="@dimen/control_border_width"
                android:color="?attr/fsAccentBorder" />
        </shape>
    </item>
</selector>
