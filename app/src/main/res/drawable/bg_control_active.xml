<?xml version="1.0" encoding="utf-8"?>
<!--
  The selected control: a held chip, a chosen unit, a segment.

  FILL plus an INDICATOR BAR (`WORKBENCH-UX-R1`). The selected-at-rest fill alone
  measured 1.22:1 against its panel, so on a sunlit tablet "which one is on" was
  a guess; the bar states it by SHAPE, at about 7:1 in textPrimary, centred
  inside the bottom edge so it never grows the 48 dp box and draws no frame.
  The accent is still spent on exactly two things — a primary commit and the
  ring on a focused field — and fsAccentBorder is still referenced by no
  drawable (those approved values are kept, not re-spent).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="?attr/fsAccentFillPressed" />
                <corners android:radius="@dimen/radius_control" />
            </shape>
        </item>
        <item android:gravity="bottom|center_horizontal" android:width="20dp" android:height="3dp" android:bottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/fsTextPrimary" />
                <corners android:radius="1.5dp" />
            </shape>
        </item>
    </layer-list>
    </item>
    <item>
        <layer-list>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="?attr/fsAccentFill" />
                <corners android:radius="@dimen/radius_control" />
            </shape>
        </item>
        <item android:gravity="bottom|center_horizontal" android:width="20dp" android:height="3dp" android:bottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/fsTextPrimary" />
                <corners android:radius="1.5dp" />
            </shape>
        </item>
    </layer-list>
    </item>
</selector>
