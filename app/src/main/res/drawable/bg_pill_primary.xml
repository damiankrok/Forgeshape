<?xml version="1.0" encoding="utf-8"?>
<!--
  A primary commit that IS the capsule rather than a member of one: Start
  Sculpting and Resume Sculpt on a window whose editing group holds nothing
  else.

  Same fill and same ink as bg_capsule_primary, on the capsule's own radius
  instead of the member radius inside it. Drawing the member form here would
  leave the control 4 dp shy of the pill it has become, and drawing the group's
  own capsule around it is the button-in-a-button this exists to remove. See
  GlobalToolbarView#applyEditingComposition.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsPrimaryFillPressed" />
            <corners android:radius="@dimen/radius_capsule" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsPrimaryFill" />
            <corners android:radius="@dimen/radius_capsule" />
        </shape>
    </item>
</selector>
