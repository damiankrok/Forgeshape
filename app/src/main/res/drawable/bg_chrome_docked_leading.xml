<?xml version="1.0" encoding="utf-8"?>
<!--
  Chrome DOCKED against the leading window edge: the expanded window's Objects
  column.

  Opaque, not translucent, and that is the difference between docked and
  floating rather than a styling preference. A surface that stands ON the model
  is translucent because the model behind it is still informative; a surface
  that sits BESIDE the model has nothing behind it to show through.

  Rounded on the side that faces the model, square against the window edge —
  the mirror of bg_inspector_side, which does the same on the trailing edge.
  Borderless: the rounded edge facing the viewport is the whole separation, and
  a hairline drawn on top of it only doubled the line.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/fsChromeSurface" />
    <corners
        android:topLeftRadius="0dp"
        android:bottomLeftRadius="0dp"
        android:topRightRadius="@dimen/radius_sheet"
        android:bottomRightRadius="@dimen/radius_sheet" />
</shape>
