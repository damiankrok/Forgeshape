<?xml version="1.0" encoding="utf-8"?>
<!--
  The extrude action panel's plate (`CAD-FOUNDATION-C2`): ONE compact surface
  holding the extent, operation and (One Side) Flip glyphs, anchored past the
  extrude arrow's point.

  Drawn at the plate's REFERENCE size and scaled as one unit with the glyphs it
  holds, so its corner stays concentric with them at every zoom: the radius is
  half the reference height (28 dp glyph + 2 x 4 dp padding). It takes no touch
  — the panel's one ≥ 48 dp group proxy does — and when the action palette is
  open it wears the same activated fill the palette's chosen member does.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsAccentFill" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/fsSurfaceFloating" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
