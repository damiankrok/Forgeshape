<?xml version="1.0" encoding="utf-8"?>
<!--
  Relative Scale: multiply the size the body already has.

  A small square growing into a larger one, with a multiplication cross between
  them. The MULTIPLY sign is the whole message and is the one difference from
  ic_gizmo_scale: that glyph says "drag this end", this one says "times this
  much", which is exactly the difference between the handles and a temporary
  multiplier.

  Drawn white and tinted at use; see EditorControlStyles.iconButton().
-->
