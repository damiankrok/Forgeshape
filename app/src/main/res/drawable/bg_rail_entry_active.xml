<?xml version="1.0" encoding="utf-8"?>
<!--
  The held Tool Rail entry.

  FILL-LED and borderless, and concentric with the rail's own 18 dp surface at
  6 dp of padding — see radius_rail_entry. It used to be bg_control_active,
  whose 10 dp corner and accent hairline were both wrong here: the corner left a
  crescent of rail showing at the top and bottom entries, and the hairline made
  the held tool read as an outlined box in a stack rather than as the one lit
  cell of one control.

  And a leading INDICATOR BAR (`WORKBENCH-UX-R1`): the fill alone was a 1.2:1
  lift, so the held tool is now also stated by a shape. It stands beside the
  ICON, in the entry's upper part, because the caption under it runs the
  entry's whole width.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="?attr/fsAccentFillPressed" />
                <corners android:radius="@dimen/radius_rail_entry" />
            </shape>
        </item>
        <item android:gravity="start|top" android:width="3dp" android:height="18dp" android:start="2dp" android:top="11dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/fsTextPrimary" />
                <corners android:radius="1.5dp" />
            </shape>
        </item>
    </layer-list>
    </item>
    <item>
        <layer-list>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="?attr/fsAccentFill" />
                <corners android:radius="@dimen/radius_rail_entry" />
            </shape>
        </item>
        <item android:gravity="start|top" android:width="3dp" android:height="18dp" android:start="2dp" android:top="11dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/fsTextPrimary" />
                <corners android:radius="1.5dp" />
            </shape>
        </item>
    </layer-list>
    </item>
</selector>
