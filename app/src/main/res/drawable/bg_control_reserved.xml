<?xml version="1.0" encoding="utf-8"?>
<!--
  A control that names something the product does not have yet: Sketch,
  Extrude, Export.

  Deliberately has NO pressed state. It is inert, and giving it press feedback
  would suggest something happened.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/fsControlSurface" />
    <corners android:radius="@dimen/radius_control" />
    <stroke
        android:width="@dimen/control_border_width"
        android:color="?attr/fsTextDisabled" />
</shape>
