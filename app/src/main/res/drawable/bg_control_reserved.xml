<?xml version="1.0" encoding="utf-8"?>
<!--
  A control that names something the product does not have yet: Sketch, Extrude,
  Export.

  Recessed rather than outlined. It sits BELOW the surface around it, which is
  the tonal way to say "not available" — an outline would have made the two
  things that do nothing the second-loudest shapes on the chrome. Disabled is
  also carried by the icon and label tint.

  Deliberately has NO pressed state. It is inert, and giving it press feedback
  would suggest something happened.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/fsFieldSurface" />
    <corners android:radius="@dimen/radius_control" />
</shape>
