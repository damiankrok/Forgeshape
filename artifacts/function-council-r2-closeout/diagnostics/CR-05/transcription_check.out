  2680	    @Override
  2681	    public void onUnsavedDiscardRequested() {
  2682	        final int intent = pendingLeave;
  2683	        pendingLeave = LEAVE_NONE;
  2684	        unsavedPrompt.setVisibility(GONE);
  2685	        // Discarding means the checkpoint that was protecting these changes has
  2686	        // nothing left to protect: left in place it would offer the very work
  2687	        // the user just chose to drop on the next launch.
  2688	        ProjectCheckpoint.clear(getContext());
  2689	        Diagnostics.info(DiagnosticLog.CAT_PERSISTENCE, "UNSAVED_DISCARDED", null);
  2690	        proceedToLeave(intent);
  2691	    }
