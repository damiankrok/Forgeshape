----- ForgeShapeActivity.java:569,584
   569	    protected void onDestroy() {
   570	        super.onDestroy();
   571	        // ALWAYS, configuration change included, and that is the difference
   572	        // between this and native code. The render thread and every GPU buffer
   573	        // are expensive and are deliberately kept alive across a recreation; the
   574	        // autosave worker is one thread that the rebuilt workspace immediately
   575	        // replaces with its own, so keeping the old one would leak a thread per
   576	        // theme change. Releasing does not cancel the checkpoint `onStop` just
   577	        // asked for — see AutosaveController#release.
   578	        if (workspace != null) {
   579	            workspace.releaseAutosave();
   580	        }
   581	        if (!isChangingConfigurations()) {
   582	            NativeViewport.stop();
   583	        }
   584	    }
