----- EditorWorkspaceView.java:5652,5701
  5652	    public void onRecoverRequested() {
  5653	        uiState.recordRecoveryResolved();
  5654	        recoveryPrompt.setVisibility(GONE);
  5655
  5656	        final byte[] bytes = ProjectCheckpoint.read(getContext());
  5657	        final int status = bytes == null
  5658	                ? NativeViewport.PROJECT_NO_DATA
  5659	                : NativeViewport.loadProject(bytes);
  5660	        if (status != NativeViewport.PROJECT_OK) {
  5661	            // Between the offer and the press the file became unreadable. The
  5662	            // load is fail-closed, so the live project is exactly what it was;
  5663	            // the candidate is retired so the next launch does not re-offer it.
  5664	            ProjectCheckpoint.quarantine(getContext());
  5665	            Diagnostics.error(DiagnosticLog.CAT_RECOVERY, "RECOVER_FAILED",
  5666	                    "status=" + status);
  5667	            refreshShellPhase();
  5668	            home.showStatus(getContext().getString(R.string.status_recovery_failed),
  5669	                    R.attr.fsTextError);
  5670	            return;
  5671	        }
  5672	        // Recovered work is the live project now, and the checkpoint has done
  5673	        // its job. It is retired rather than kept: leaving it would offer the
  5674	        // same work again on the next launch, as though it had been lost twice.
  5675	        ProjectCheckpoint.clear(getContext());
  5676	        autosave.noteProjectPersisted();
  5677	        // What was recovered is what the user has: a New Project straight after
  5678	        // this asks nothing, exactly as after an Open.
  5679	        noteProjectPersisted();
  5680	        dismissPrimarySurfacesExcept(null);
  5681	        onNativeStateChanged();
  5682	        Diagnostics.info(DiagnosticLog.CAT_RECOVERY, "RECOVERED",
  5683	                "bodies=" + NativeViewport.sceneBodyCount());
  5684	        showStatus(getContext().getString(R.string.status_recovery_recovered, projectSummary()),
  5685	                R.attr.fsTextSuccess);
  5686	    }
  5687
  5688	    @Override
  5689	    public void onDiscardRecoveryRequested() {
  5690	        uiState.recordRecoveryResolved();
  5691	        recoveryPrompt.setVisibility(GONE);
  5692	        // The only thing discarded is the checkpoint. The manual slot is not
  5693	        // touched, not read and not written by this — which is exactly what the
  5694	        // option's description promises the user.
  5695	        ProjectCheckpoint.clear(getContext());
  5696	        Diagnostics.info(DiagnosticLog.CAT_RECOVERY, "DISCARDED", null);
  5697	        // Discarding means starting normally: Home, which was deferred to make
  5698	        // room for this question, stands now and carries the verdict.
  5699	        refreshShellPhase();
  5700	        home.showStatus(getContext().getString(R.string.status_recovery_discarded),
  5701	                R.attr.fsTextPrimary);
