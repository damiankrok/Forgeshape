  2634	    /** Continues what the unsaved-changes question was guarding. */
  2635	    private void proceedToLeave(int intent) {
  2636	        switch (intent) {
  2637	            case LEAVE_NEW_PROJECT:
  2638	                // The project closes NOW, so the chooser stands over Home and
  2639	                // Cancel from it lands at Home rather than back in a project
  2640	                // the user has already decided to leave.
  2641	                NativeViewport.closeProject();
  2642	                dismissPrimarySurfacesExcept(null);
  2643	                finishEditing();
  2644	                noteProjectUnpersisted();
  2645	                uiState.setNewProjectChooserOpen(true);
  2646	                onNativeStateChanged();
  2647	                break;
  2648	            case LEAVE_OPEN_FILE:
  2649	                // The current project stays live until a file actually opens:
  2650	                // a cancelled picker or a refused file costs it nothing.
  2651	                if (transferHost == null || !transferHost.requestOpenProjectDocument()) {
  2652	                    showStatus(getContext().getString(R.string.status_project_copy_failed),
  2653	                            R.attr.fsTextError);
  2654	                }
  2655	                break;
  2656	            case LEAVE_OPEN_SLOT:
  2657	                openSavedProjectSlot();
  2658	                break;
  2659	            default:
  2660	                break;
  2661	        }
  2662	    }
