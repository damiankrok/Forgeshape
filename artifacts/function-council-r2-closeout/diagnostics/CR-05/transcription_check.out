  5458	    private boolean saveProjectToSlot() {
  5459	        final byte[] bytes = NativeViewport.encodeProject();
  5460	        if (bytes == null || bytes.length == 0
  5461	                || !ProjectSlot.write(getContext(), bytes)) {
  5462	            return false;
  5463	        }
  5464	        // The work the checkpoint was protecting is now in the slot the user
  5465	        // named, so the checkpoint has nothing left to protect and is retired.
  5466	        // Autosave writes a fresh one the moment the project changes again.
  5467	        ProjectCheckpoint.clear(getContext());
  5468	        autosave.noteProjectPersisted();
  5469	        noteProjectPersisted();
  5470	        Diagnostics.info(DiagnosticLog.CAT_PERSISTENCE, "MANUAL_SAVE",
  5471	                "bytes=" + bytes.length);
  5472	        return true;
----- EditorWorkspaceView.java:5483,5513
  5483	    private void openSavedProjectSlot() {
  5484	        final byte[] bytes = ProjectSlot.read(getContext());
  5485	        if (bytes == null) {
  5486	            showStatus(getContext().getString(R.string.status_project_none), R.attr.fsTextError);
  5487	            return;
  5488	        }
  5489	        final int status = NativeViewport.loadProject(bytes);
  5490	        if (status != NativeViewport.PROJECT_OK) {
  5491	            // Nothing to refresh: a refused load changed nothing below JNI, so
  5492	            // re-reading would repaint the same values it already shows.
  5493	            showStatus(getContext().getString(projectFailureMessage(status)),
  5494	                    R.attr.fsTextError);
  5495	            return;
  5496	        }
  5497	        // Everything on screen is now describing a scene that no longer exists:
  5498	        // the active body, its dimensions, its placement, the mode, the scene
  5499	        // list and whether Undo is available have all been replaced at once.
  5500	        // One re-read from native truth answers all of it, which is exactly
  5501	        // what syncFromNative is for.
  5502	        // The live project and the internal slot now agree, so the next
  5503	        // checkpoint of unchanged work is free rather than merely fast. The
  5504	        // checkpoint is retired for the same reason a Save retires it.
  5505	        ProjectCheckpoint.clear(getContext());
  5506	        autosave.noteProjectPersisted();
  5507	        noteProjectPersisted();
  5508	        Diagnostics.info(DiagnosticLog.CAT_PERSISTENCE, "MANUAL_OPEN",
  5509	                "bytes=" + bytes.length);
  5510	        dismissPrimarySurfacesExcept(null);
  5511	        onNativeStateChanged();
  5512	        showStatus(getContext().getString(R.string.status_project_opened, projectSummary()),
  5513	                R.attr.fsTextSuccess);
----- EditorWorkspaceView.java:5579,5604
  5579	    private boolean offerRecoveryIfPresent() {
  5580	        if (!ProjectCheckpoint.exists(getContext())) {
  5581	            return false;
  5582	        }
  5583	        final byte[] bytes = ProjectCheckpoint.read(getContext());
  5584	        final int status = bytes == null
  5585	                ? NativeViewport.PROJECT_NO_DATA
  5586	                : NativeViewport.validateProject(bytes);
  5587	        if (status != NativeViewport.PROJECT_OK) {
  5588	            // Nothing has been applied and nothing can have been: validate is a
  5589	            // decode into temporary state. The live project is whatever a fresh
  5590	            // launch built, untouched.
  5591	            ProjectCheckpoint.quarantine(getContext());
  5592	            uiState.recordRecoveryResolved();
  5593	            Diagnostics.warn(DiagnosticLog.CAT_RECOVERY, "CANDIDATE_QUARANTINED",
  5594	                    "status=" + status);
  5595	            showStatus(getContext().getString(R.string.status_recovery_failed),
  5596	                    R.attr.fsTextError);
  5597	            return false;
  5598	        }
  5599	        Diagnostics.info(DiagnosticLog.CAT_RECOVERY, "CANDIDATE_OFFERED",
  5600	                "bytes=" + bytes.length);
  5601	        recoveryPrompt.setVisibility(VISIBLE);
  5602	        return true;
  5603	    }
