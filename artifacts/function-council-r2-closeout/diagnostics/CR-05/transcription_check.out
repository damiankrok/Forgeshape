   268	    void requestTheme(AppTheme theme) {
   269	        final AppPreferences before = AppPreferencesStore.current(this);
   270	        if (theme == null || !AppPreferencesStore.update(this, before.withPalette(theme))) {
   271	            return;  // already wearing it; recreating would flash for nothing
